{
  "impeccable": {
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "cmd /c if exist \"..\\.agent\\skills\\impeccable\\scripts\\impeccable.cmd\" \"..\\.agent\\skills\\impeccable\\scripts\\impeccable.cmd\" hook",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "cmd /c if exist \"..\\.agent\\skills\\impeccable\\scripts\\impeccable.cmd\" \"..\\.agent\\skills\\impeccable\\scripts\\impeccable.cmd\" hook",
        "timeout": 30
      }
    ]
  }
}
