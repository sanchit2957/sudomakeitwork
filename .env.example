# Local Development & Production Environment Configuration Template
# Copy to .env for local development

NODE_ENV=development
PORT=3000

# Session Secret (Required in production: use a secure random 32+ character string)
JWT_SECRET=development-session-secret-key-32-chars-min

# Database URL (Required in production for MySQL persistence)
# Format: mysql://user:password@localhost:3306/assam_rescue
DATABASE_URL=

# Web Push VAPID Configuration (Optional: required for browser push notifications)
VAPID_SUBJECT=mailto:admin@assamrescue.gov.in
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Allowed CORS Origins (Optional: comma-separated list of origins for production)
ALLOWED_ORIGINS=

# External OAuth / Social Sign-in (Optional: leave empty to use built-in authentication)
OAUTH_SERVER_URL=
VITE_APP_ID=local-app
VITE_APP_TITLE=sudo MakeItWork
