# Local Development & Production Environment Configuration Template
# Copy to .env for local development

NODE_ENV=development
PORT=3000

# Session Secret (Required in production: use a secure random 32+ character string)
JWT_SECRET=development-session-secret-key-32-chars-min

# Database URL (Required in production for MySQL persistence)
# Format: mysql://user:password@localhost:3306/assam_rescue
DATABASE_URL=

# Web Push VAPID Configuration (Optional: required for browser push notifications)
VAPID_SUBJECT=mailto:admin@assamrescue.gov.in
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Allowed CORS Origins (Optional: comma-separated list of origins for production)
ALLOWED_ORIGINS=

# Supabase Configuration (Optional: set to connect Supabase Auth & PostgreSQL)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Initial Admin Password (Optional: Set for production initial admin seed)
ADMIN_INITIAL_PASSWORD=replace-with-secure-32-char-admin-password

# Production Backend API URL for Native Mobile Apps (Capacitor)
VITE_API_URL=https://assam-rescue-platform.onrender.com

# External OAuth / Social Sign-in (Optional: leave empty to use built-in authentication)
OAUTH_SERVER_URL=
VITE_APP_ID=local-app
VITE_APP_TITLE=sudo MakeItWork

# Google Maps JavaScript API (Optional: add your Google Maps API Key to enable Google Maps)
VITE_GOOGLE_MAPS_API_KEY=

# Multi-Provider Weather Engine Configuration (Server-Side Only)
# Primary: Open-Meteo (works out-of-the-box with no API key)
# Fallback 1: OpenWeatherMap (Optional: provide key for secondary fallback)
OPENWEATHER_API_KEY=
WEATHER_PROVIDER_FALLBACK_API_KEY=

# Fallback 2: WeatherAPI.com (Optional: provide key for tertiary fallback & alerts)
WEATHERAPI_API_KEY=
WEATHER_PROVIDER_SECONDARY_API_KEY=

# Google Gemini API (Get from Google AI Studio)
GEMINI_API_KEY=

# n8n Automation & Escalation Webhooks (Server-Side Only)
N8N_SOS_WEBHOOK_URL=https://your-n8n-instance.app.n8n.cloud/webhook/your-sos-webhook-path
N8N_FLOOD_ALERT_WEBHOOK_URL=https://your-n8n-instance.app.n8n.cloud/webhook/your-flood-webhook-path